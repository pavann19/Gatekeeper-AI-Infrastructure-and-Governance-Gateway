# Copy to .env and configure locally. Never commit the populated file.
# Compose explicitly configures identity/state paths; see docs/DEPLOYMENT_RUNBOOK.md.
AUTH_MODE=optional

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTHENTICATED_RPM=120
RATE_LIMIT_ANONYMOUS_RPM=20

ASSESS_MAX_CONCURRENCY=4
ASSESS_TIMEOUT_SECONDS=30

METRICS_ENABLED=true
METRICS_REQUIRE_AUTH=false

DOMAIN_GUARDRAIL_MODE=off

CORS_ORIGINS=*

AUDIT_LOG_PATH=audit.jsonl

GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ANONYMOUS_ENABLED=false

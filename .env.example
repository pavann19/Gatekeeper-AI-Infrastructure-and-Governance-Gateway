# Copy to .env and edit. docker-compose.yml loads it automatically
# (env_file, required: false) — everything here is optional; every value
# shown is core/config.py's own default, so an empty .env changes nothing.
#
# Do NOT commit a real .env — see .gitignore / .dockerignore.

# --- Authentication (core/auth.py) ---
# "optional": anonymous requests served at GENERAL (least privilege).
# "required": anonymous requests get 401.
AUTH_MODE=optional

# --- Rate limiting (core/rate_limit.py) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTHENTICATED_RPM=120
RATE_LIMIT_ANONYMOUS_RPM=20

# --- Assessment execution bounds (api/main.py) ---
# Small on purpose — see Dockerfile.api / docs/ENGINEERING_ASSESSMENT.md §1q
# for why a larger pool oversubscribes the CPU rather than serving more
# requests. Increase only after measuring on YOUR hardware, the way §1m did.
ASSESS_MAX_CONCURRENCY=4
ASSESS_TIMEOUT_SECONDS=30

# --- Metrics (core/metrics.py) ---
# Metrics leak operational detail (traffic volume, block rates, active
# tenants). METRICS_REQUIRE_AUTH=true is worth setting if /metrics is
# reachable from outside your monitoring network.
METRICS_ENABLED=true
METRICS_REQUIRE_AUTH=false

# --- Domain guardrail (core/domain_classifier.py) ---
# "off" (default) is deliberate — the shipped domain corpus describes THIS
# project's own subject area. Do not set to "enforcing" without first
# supplying your own corpus; see docs/ENGINEERING_ASSESSMENT.md §1 for what
# happens if you skip that step (98% false-positive rate, measured).
DOMAIN_GUARDRAIL_MODE=off

# --- CORS ---
# Wildcard disables credentialed cross-origin requests automatically
# (api/main.py) — set an explicit comma-separated allowlist to permit them.
CORS_ORIGINS=*

# --- Audit log (core/logger.py) ---
# Relative to cwd by default. A container deployment should point this at
# a mounted volume — see docker-compose.yml — since the audit record is
# this project's compliance artefact and must not be silently discarded
# on every container recreation.
AUDIT_LOG_PATH=audit.jsonl

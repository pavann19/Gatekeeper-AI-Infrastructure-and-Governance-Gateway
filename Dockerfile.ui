# Same Python version as Dockerfile.api — see that file's comment for why
# tested and deployed versions must match.
#
# HONEST LIMITATION, not fixed by this Dockerfile: ui/web_app.py calls
# Ollama DIRECTLY (payload built against /api/generate, OLLAMA_MODEL
# defaulting to "mistral") rather than calling the Gatekeeper API this
# project has actually built — it never reaches core/risk.py's pipeline,
# so it exercises none of the fusion, cache, tenancy, or policy work this
# session added. That is a UI logic gap, not a deployment one, and fixing
# it means rewriting web_app.py's request path, not this file. Documented
# in docs/ENGINEERING_ASSESSMENT.md rather than silently patched over.
FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ui/ ./ui/

EXPOSE 8501

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

CMD ["streamlit", "run", "ui/web_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
